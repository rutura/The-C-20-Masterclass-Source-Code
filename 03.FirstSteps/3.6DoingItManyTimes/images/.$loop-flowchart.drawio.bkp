<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Loop Flowchart" id="loop-flowchart">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Starting state -->
        <mxCell id="start" value="starting state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="start-note" value="friends starts empty" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="55" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Stop check diamond -->
        <mxCell id="stopcheck" value="stop check&#10;friendName empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="160" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stopcheck-note" value="&quot;did the user press enter&#10;on an empty line?&quot;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- Done -->
        <mxCell id="done" value="done" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Loop body -->
        <mxCell id="loopbody" value="loop body" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="330" y="320" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="loopbody-note" value="read a name,&#10;push_back it" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="335" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="stopcheck">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stopcheck" target="done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stopcheck" target="loopbody">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="go back and check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="loopbody" target="stopcheck">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="355" />
              <mxPoint x="260" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
